.DS_Store
.claude/

local/
config/host-redirects.yaml
docker-compose.infrastructure.yml

# Private plugins (contain inline config / secrets)
plugins/custom/

# Stage-Plattform ist public (StageBase + Assets + ManageStage als
# Maintenance-Instanz). Die persönliche Stage-Instanz (config/stage.yaml +
# plugins/custom/56-stage.rb) bleibt privat. Dasselbe für die Board-Instanz
# (config/board.yaml + plugins/custom/57-board.rb).
config/stage.yaml
config/board.yaml

# Sicherungskopien davon sind genauso privat wie das Original — ohne dieses
# Muster hängt ein `git add -A` die Kopie einer gitignorierten Config an ein
# öffentliches Repo.
config/*.bak*
config/*.yaml.[0-9]*

# Runtime data (generated by scripts) — Verzeichnis selbst bleibt via .gitkeep
data/*
!data/.gitkeep
data/cheatsheet/
