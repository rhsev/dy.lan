# Don't copy these into Docker image
# (patterns need **/ to match in subdirectories — unlike .gitignore)
.git
**/.DS_Store
**/*.md
**/*.backup
test_performance.rb
docker-compose.yml

# Synology metadata sidecars (extended attributes, thumbnails, index data).
# DSM hides these over SMB, so they are invisible from macOS — but they are
# real files in the build context on a NAS deployment.
**/@eaDir

# Runtime state and local working files — they change constantly and would
# give every rebuild a new image ID
data/
local/
config/stage.yaml
config/board.yaml
config/*.bak*
config/*.yaml.[0-9]*
